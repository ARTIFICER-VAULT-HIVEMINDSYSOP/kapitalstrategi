{
  "name": "traderider",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Traderider practice desk. Historical NVDA, fictional play balance, no broker in the demo build.",
  "scripts": {
    "dev": "vite dev --port 3017 --host",
    "build": "vite build",
    "build:static": "vite build --config vite.static.config.ts",
    "build:try": "TRADERIDER_TRY=1 vite build --config vite.static.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/check-demo.mjs",
    "preview:demo": "vite preview --config vite.demo.config.ts --port 3021 --host --strictPort",
    "preview:static": "vite preview --config vite.static.config.ts --port 3019 --host",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "nitro": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
